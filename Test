-- SERVICIOS
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local jugador = Players.LocalPlayer
local carpeta = workspace:WaitForChild("QuestPumpkins")

-- CONFIGURACIÓN
local TIEMPO_ESPERA = 3
local VELOCIDAD = 16
local DISTANCIA_LLEGADA = 5
local MAX_INTENTOS = 3

local procesados = {}

-- OBTENER PERSONAJE
local function obtenerPersonaje()
    local personaje = jugador.Character
        or jugador.CharacterAdded:Wait()

    local humanoid = personaje:WaitForChild("Humanoid")
    local root = personaje:WaitForChild("HumanoidRootPart")

    humanoid.WalkSpeed = VELOCIDAD

    return personaje, humanoid, root
end

-- OBTENER POSICIÓN
local function obtenerPosicion(objeto)
    if objeto:IsA("BasePart") then
        return objeto.Position
    elseif objeto:IsA("Model") then
        return objeto:GetPivot().Position
    end

    return nil
end

-- BUSCAR OBJETO MÁS CERCANO
local function buscarObjetoCercano()
    local _, _, root = obtenerPersonaje()

    local mejorObjeto = nil
    local menorDistancia = math.huge

    for _, objeto in ipairs(carpeta:GetChildren()) do
        if not procesados[objeto] and objeto.Parent == carpeta then
            local posicion = obtenerPosicion(objeto)

            if posicion then
                local distancia =
                    (root.Position - posicion).Magnitude

                if distancia < menorDistancia then
                    menorDistancia = distancia
                    mejorObjeto = objeto
                end
            end
        end
    end

    return mejorObjeto
end

-- CAMINAR USANDO PATHFINDING
local function caminarHasta(objeto)
    for intento = 1, MAX_INTENTOS do
        local personaje, humanoid, root = obtenerPersonaje()

        if humanoid.Health <= 0 or not objeto.Parent then
            return false
        end

        local destino = obtenerPosicion(objeto)

        if not destino then
            return false
        end

        local ruta = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            WaypointSpacing = 4
        })

        local calculada = pcall(function()
            ruta:ComputeAsync(root.Position, destino)
        end)

        if not calculada
            or ruta.Status ~= Enum.PathStatus.Success then

            task.wait(0.2)
            continue
        end

        local waypoints = ruta:GetWaypoints()
        local bloqueado = false
        local indiceActual = 1

        local conexion = ruta.Blocked:Connect(function(indice)
            if indice >= indiceActual then
                bloqueado = true
            end
        end)

        local exito = true

        -- Seguir cada punto sin emitir MoveTo repetidamente
        for i, punto in ipairs(waypoints) do
            indiceActual = i

            if humanoid.Health <= 0 or not objeto.Parent then
                exito = false
                break
            end

            if bloqueado then
                exito = false
                break
            end

            -- Si ya está cerca del punto, continuar
            if (root.Position - punto.Position).Magnitude > 2 then
                if punto.Action ==
                    Enum.PathWaypointAction.Jump then

                    humanoid.Jump = true
                end

                humanoid:MoveTo(punto.Position)

                local inicio = os.clock()
                local posicionAnterior = root.Position
                local ultimoProgreso = os.clock()

                -- Esperar la llegada comprobando el progreso
                while humanoid.Health > 0 do
                    if not objeto.Parent or bloqueado then
                        exito = false
                        break
                    end

                    if (root.Position - punto.Position).Magnitude <= 2.5 then
                        break
                    end

                    if os.clock() - inicio > 10 then
                        exito = false
                        break
                    end

                    if (root.Position - posicionAnterior).Magnitude > 0.3 then
                        posicionAnterior = root.Position
                        ultimoProgreso = os.clock()
                    elseif os.clock() - ultimoProgreso > 2 then
                        exito = false
                        break
                    end

                    task.wait(0.1)
                end

                if not exito then
                    break
                end
            end
        end

        conexion:Disconnect()

        if exito then
            local posicionFinal = obtenerPosicion(objeto)

            if posicionFinal
                and (root.Position - posicionFinal).Magnitude
                    <= DISTANCIA_LLEGADA then

                return true
            end
        end

        -- Dar tiempo antes de calcular una ruta nueva
        task.wait(0.2)
    end

    return false
end

-- RECORRIDO PRINCIPAL
local function iniciarRecorrido()
    while true do
        local objeto = buscarObjetoCercano()

        if not objeto then
            print("No quedan objetos por visitar.")
            break
        end

        print("Dirigiéndose a:", objeto.Name)

        local llego = caminarHasta(objeto)

        if llego then
            print("Llegó a:", objeto.Name)

            -- Esperar tres segundos
            task.wait(TIEMPO_ESPERA)
        else
            warn("No se pudo alcanzar:", objeto.Name)
        end

        -- Evitar seleccionar repetidamente el mismo objetivo
        procesados[objeto] = true

        task.wait(0.1)
    end
end

iniciarRecorrido()
