-- SERVICIOS
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")

local jugador = Players.LocalPlayer
local carpeta = workspace:WaitForChild("QuestPumpkins")

-- CONFIGURACIÓN
local TIEMPO_ESPERA = 3
local VELOCIDAD = 16
local DISTANCIA_LLEGADA = 5
local DISTANCIA_RECALCULO = 8

local procesados = {}
local detenido = false

-- OBTENER PERSONAJE
local function obtenerPersonaje()
    local personaje = jugador.Character or jugador.CharacterAdded:Wait()
    local humanoid = personaje:WaitForChild("Humanoid")
    local root = personaje:WaitForChild("HumanoidRootPart")

    humanoid.WalkSpeed = VELOCIDAD

    return personaje, humanoid, root
end

-- POSICIÓN DEL OBJETO
local function obtenerPosicion(objeto)
    if objeto:IsA("BasePart") then
        return objeto.Position
    elseif objeto:IsA("Model") then
        return objeto:GetPivot().Position
    end

    return nil
end

-- BUSCAR EL OBJETO MÁS CERCANO
local function buscarObjetoCercano()
    local _, _, root = obtenerPersonaje()

    local mejorObjeto = nil
    local menorDistancia = math.huge

    for _, objeto in ipairs(carpeta:GetChildren()) do
        if not procesados[objeto] and objeto.Parent == carpeta then
            local posicion = obtenerPosicion(objeto)

            if posicion then
                local distancia =
                    (root.Position - posicion).Magnitude

                if distancia < menorDistancia then
                    menorDistancia = distancia
                    mejorObjeto = objeto
                end
            end
        end
    end

    return mejorObjeto
end

-- MOVIMIENTO CON RECALCULO DE RUTA
local function caminarHasta(destino)
    local personaje, humanoid, root = obtenerPersonaje()

    local ruta = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        WaypointSpacing = 5
    })

    local correcto = pcall(function()
        ruta:ComputeAsync(root.Position, destino)
    end)

    if not correcto or ruta.Status ~= Enum.PathStatus.Success then
        return false
    end

    local waypoints = ruta:GetWaypoints()
    local indice = 2
    local ultimaPosicion = root.Position
    local tiempoRecalculo = 0

    while indice <= #waypoints do
        if humanoid.Health <= 0 then
            return false
        end

        if not destino then
            return false
        end

        local punto = waypoints[indice]

        -- Saltar si es necesario
        if punto.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        -- Mantener el movimiento hacia el siguiente punto
        humanoid:MoveTo(punto.Position)

        -- Esperar brevemente mientras se comprueba el progreso
        local tiempoInicio = os.clock()

        while os.clock() - tiempoInicio < 0.15 do
            RunService.Heartbeat:Wait()

            if humanoid.Health <= 0 then
                return false
            end

            if (root.Position - punto.Position).Magnitude <= 2.5 then
                indice += 1
                break
            end
        end

        -- Detectar si el personaje está atascado
        tiempoRecalculo += 0.15

        if tiempoRecalculo >= 1 then
            local movimiento =
                (root.Position - ultimaPosicion).Magnitude

            if movimiento < 0.5 then
                break
            end

            ultimaPosicion = root.Position
            tiempoRecalculo = 0
        end
    end

    -- Comprobar llegada
    return (root.Position - destino).Magnitude
        <= DISTANCIA_LLEGADA
end

-- RECORRIDO AUTOMÁTICO
local function iniciar()
    while not detenido do
        local objeto = buscarObjetoCercano()

        if not objeto then
            print("Recorrido terminado.")
            break
        end

        local destino = obtenerPosicion(objeto)

        if destino then
            print("Yendo hacia:", objeto.Name)

            local llego = caminarHasta(destino)

            if llego then
                print("Llegaste a:", objeto.Name)

                -- Esperar tres segundos en el objeto
                task.wait(TIEMPO_ESPERA)

                procesados[objeto] = true
            else
                warn("No se pudo llegar a:", objeto.Name)
                procesados[objeto] = true
            end
        else
            procesados[objeto] = true
        end

        -- Sin pausas innecesarias entre objetivos
        RunService.Heartbeat:Wait()
    end
end

iniciar()
