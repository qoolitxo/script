-- CONFIGURACIÓN
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local player = Players.LocalPlayer
local carpeta = workspace:WaitForChild("QuestPumpkins")

local TIEMPO_ESPERA = 3
local DISTANCIA_LLEGADA = 4

-- Esperar al personaje
local function obtenerPersonaje()
    local personaje = player.Character or player.CharacterAdded:Wait()
    local humanoid = personaje:WaitForChild("Humanoid")
    local root = personaje:WaitForChild("HumanoidRootPart")

    return personaje, humanoid, root
end

-- Obtener la posición de un objeto
local function obtenerPosicion(objeto)
    if objeto:IsA("BasePart") then
        return objeto.Position
    elseif objeto:IsA("Model") then
        return objeto:GetPivot().Position
    end

    return nil
end

-- Caminar hacia un destino usando rutas que evitan obstáculos
local function caminarHasta(destino)
    local personaje, humanoid, root = obtenerPersonaje()

    local ruta = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 4
    })

    local exito = pcall(function()
        ruta:ComputeAsync(root.Position, destino)
    end)

    if not exito or ruta.Status ~= Enum.PathStatus.Success then
        warn("No se encontró una ruta hacia el objeto.")
        return false
    end

    local waypoints = ruta:GetWaypoints()

    for _, punto in ipairs(waypoints) do
        if humanoid.Health <= 0 then
            return false
        end

        if punto.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(punto.Position)

        local llegado = humanoid.MoveToFinished:Wait()

        if not llegado then
            return false
        end
    end

    return (root.Position - destino).Magnitude <= DISTANCIA_LLEGADA
end

-- Detectar obstáculos frente al jugador mediante raycasting
local function detectarObstaculo()
    local personaje, humanoid, root = obtenerPersonaje()

    local parametros = RaycastParams.new()
    parametros.FilterType = Enum.RaycastFilterType.Exclude
    parametros.FilterDescendantsInstances = {personaje}

    local origen = root.Position
    local direccion = root.CFrame.LookVector * 8

    local resultado = workspace:Raycast(
        origen,
        direccion,
        parametros
    )

    if resultado then
        print("Obstáculo detectado:", resultado.Instance.Name)
        return resultado.Instance
    end

    return nil
end

-- Recorrer todos los objetos de la carpeta
local function iniciarRecorrido()
    while true do
        local objetos = carpeta:GetChildren()

        for _, objeto in ipairs(objetos) do
            local destino = obtenerPosicion(objeto)

            if destino then
                print("Yendo hacia:", objeto.Name)

                local llego = caminarHasta(destino)

                if llego then
                    print("Llegada:", objeto.Name)

                    task.wait(TIEMPO_ESPERA)
                else
                    warn("No se pudo llegar a:", objeto.Name)
                end
            end
        end

        -- Si no quedan objetos, detener el recorrido
        if #carpeta:GetChildren() == 0 then
            break
        end

        task.wait(0.1)
    end
end

iniciarRecorrido()
