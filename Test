-- Obtener los objetivos
local function obtenerObjetivos()
    local objetivos = {}

    for _, objeto in ipairs(carpeta:GetChildren()) do
        if obtenerPosicion(objeto) then
            table.insert(objetivos, objeto)
        end
    end

    return objetivos
end

-- Recorrido automático
for _, objetivo in ipairs(obtenerObjetivos()) do
    if not objetivo.Parent then
        continue
    end

    local destino = obtenerPosicion(objetivo)

    if destino then
        print("Yendo hacia:", objetivo.Name)

        local llego = caminarHacia(destino)

        if llego then
            apuntarHacia(destino)

            clicDerecho(objetivo)
            task.wait(0.3)

            apuntarHacia(destino)
            clicIzquierdo(objetivo)

            task.wait(0.5)
        end
    end
end

print("Recorrido finalizado.")
