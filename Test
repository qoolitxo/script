local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local player = Players.LocalPlayer

-- PUNTOS DE DESTINO
local puntoA = workspace.HalloweenDeco:GetChildren()[119].Pumpkin
local puntoB = workspace:GetChildren()[42]:GetChildren()[24]["Cylinder.004"]

-- CONFIGURACIÓN
local DISTANCIA_LLEGADA = 4
local TIEMPO_ATASCADO = 3
local RADIO_AGENTE = 2
local ALTURA_AGENTE = 5

local function obtenerPosicion(objeto)
    if objeto:IsA("BasePart") then
        return objeto.Position
    elseif objeto:IsA("Model") then
        return objeto:GetPivot().Position
    end

    error("El destino no es una pieza ni un modelo válido")
end

local function calcularRuta(origen, destino)
    local ruta = PathfindingService:CreatePath({
        AgentRadius = RADIO_AGENTE,
        AgentHeight = ALTURA_AGENTE,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 4
    })

    local exito = pcall(function()
        ruta:ComputeAsync(origen, destino)
    end)

    if exito and ruta.Status == Enum.PathStatus.Success then
        return ruta
    end

    return nil
end

local function caminarA(destino)
    local personaje = player.Character or player.CharacterAdded:Wait()
    local humanoid = personaje:WaitForChild("Humanoid")
    local root = personaje:WaitForChild("HumanoidRootPart")

    local ultimaPosicion = root.Position
    local ultimoProgreso = os.clock()

    while humanoid.Health > 0 do
        if (root.Position - destino).Magnitude <= DISTANCIA_LLEGADA then
            return true
        end

        local ruta = calcularRuta(root.Position, destino)

        if not ruta then
            warn("No se encontró una ruta. Se volverá a intentar.")
            task.wait(1)
            continue
        end

        local bloqueada = false

        local conexion = ruta.Blocked:Connect(function()
            bloqueada = true
        end)

        local necesitaRecalcular = false

        for indice, waypoint in ipairs(ruta:GetWaypoints()) do
            if indice > 1 then
                if bloqueada then
                    necesitaRecalcular = true
                    break
                end

                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                end

                humanoid:MoveTo(waypoint.Position)

                local inicio = os.clock()

                while humanoid.Health > 0 do
                    task.wait(0.15)

                    if (root.Position - destino).Magnitude
                        <= DISTANCIA_LLEGADA then
                        conexion:Disconnect()
                        return true
                    end

                    if bloqueada then
                        necesitaRecalcular = true
                        break
                    end

                    if (root.Position - ultimaPosicion).Magnitude >= 1 then
                        ultimaPosicion = root.Position
                        ultimoProgreso = os.clock()
                    end

                    if os.clock() - ultimoProgreso >= TIEMPO_ATASCADO then
                        warn("Personaje atascado. Recalculando ruta.")
                        humanoid.Jump = true
                        necesitaRecalcular = true
                        break
                    end

                    if os.clock() - inicio >= 5 then
                        necesitaRecalcular = true
                        break
                    end

                    if (root.Position - waypoint.Position).Magnitude
                        <= DISTANCIA_LLEGADA then
                        break
                    end
                end

                if necesitaRecalcular then
                    break
                end
            end
        end

        conexion:Disconnect()
        task.wait(0.2)
    end

    return false
end

-- RECORRIDO: A -> B
local function iniciarRecorrido()
    local exito, resultado = pcall(function()
        local posicionA = obtenerPosicion(puntoA)
        local posicionB = obtenerPosicion(puntoB)

        print("Iniciando recorrido desde A hasta B.")

        -- Primero se dirige al punto A.
        local llegoA = caminarA(posicionA)

        if not llegoA then
            warn("No se pudo alcanzar el punto A.")
            return
        end

        print("Punto A alcanzado. Dirigiéndose al punto B.")

        -- Después continúa hacia el punto B.
        local llegoB = caminarA(posicionB)

        if llegoB then
            print("¡Punto B alcanzado!")
        else
            warn("No se pudo alcanzar el punto B.")
        end
    end)

    if not exito then
        warn("Error en el recorrido: " .. tostring(resultado))
    end
end

iniciarRecorrido()
