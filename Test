local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local player = Players.LocalPlayer

local CARPETA = workspace:WaitForChild("QuestPumpkins")
local DISTANCIA_OBJETO = 4
local TIEMPO_ESPERA = 3
local VELOCIDAD = 16

local procesadas = {}
local ocupado = false

local function obtenerPersonaje()
local personaje = player.Character or player.CharacterAdded:Wait()
local humanoid = personaje:WaitForChild("Humanoid")
local root = personaje:WaitForChild("HumanoidRootPart")
return personaje, humanoid, root
end

local function obtenerPosicion(objeto)
if objeto:IsA("Model") then
return objeto:GetPivot().Position
elseif objeto:IsA("BasePart") then
return objeto.Position
end
return nil
end

local function buscarMasCercana(root)
local mejorObjeto = nil
local mejorDistancia = math.huge

for _, objeto in ipairs(CARPETA:GetChildren()) do
    if not procesadas[objeto] and objeto.Parent then
        local posicion = obtenerPosicion(objeto)

        if posicion then
            local distancia = (root.Position - posicion).Magnitude

            if distancia < mejorDistancia then
                mejorDistancia = distancia
                mejorObjeto = objeto
            end
        end
    end
end

return mejorObjeto

end

local function caminarA(humanoid, root, destino)
local path = PathfindingService:CreatePath({
AgentRadius = 2,
AgentHeight = 5,
AgentCanJump = true,
WaypointSpacing = 4
})

local exito = pcall(function()
    path:ComputeAsync(root.Position, destino)
end)

if not exito or path.Status ~= Enum.PathStatus.Success then
    warn("No se pudo calcular una ruta.")
    return false
end

local puntos = path:GetWaypoints()

for _, punto in ipairs(puntos) do
    if humanoid.Health <= 0 then
        return false
    end

    if punto.Action == Enum.PathWaypointAction.Jump then
        humanoid.Jump = true
    end

    humanoid:MoveTo(punto.Position)
    local llego = humanoid.MoveToFinished:Wait()

    if not llego then
        warn("El personaje no pudo llegar al siguiente punto.")
        return false
    end
end

return true

end

local function iniciar()
if ocupado then return end
ocupado = true

local personaje, humanoid, root = obtenerPersonaje()
humanoid.WalkSpeed = VELOCIDAD

while humanoid.Health > 0 do
    local objeto = buscarMasCercana(root)

    if not objeto then
        task.wait(1)
        continue
    end

    local posicion = obtenerPosicion(objeto)

    if not posicion then
        procesadas[objeto] = true
        continue
    end

    local direccion = root.Position - posicion

    if direccion.Magnitude < 0.01 then
        direccion = Vector3.new(1, 0, 0)
    else
        direccion = direccion.Unit
    end

    local destino = posicion + direccion * DISTANCIA_OBJETO
    local llego = caminarA(humanoid, root, destino)

    if llego and objeto.Parent then
        task.wait(TIEMPO_ESPERA)
        procesadas[objeto] = true
    else
        task.wait(1)
    end

    if player.Character ~= personaje then
        break
    end
end

ocupado = false

end

player.CharacterAdded:Connect(function()
task.wait(1)
iniciar()
end)

iniciar()
