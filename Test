local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local player = Players.LocalPlayer
local carpeta = workspace:WaitForChild("QuestPumpkins")

local DISTANCIA_LLEGADA = 5
local TIEMPO_REINTENTO = 1

-- Obtener la posición del objetivo
local function obtenerPosicion(objeto)
    if objeto:IsA("BasePart") then
        return objeto.Position
    elseif objeto:IsA("Model") then
        return objeto:GetPivot().Position
    end

    return nil
end

-- Calcular una ruta
local function calcularRuta(origen, destino)
    local ruta = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 4
    })

    local correcto = pcall(function()
        ruta:ComputeAsync(origen, destino)
    end)

    if correcto and ruta.Status == Enum.PathStatus.Success then
        return ruta
    end

    return nil
end

-- Caminar hacia el objetivo
local function caminarHacia(destino)
    local personaje = player.Character or player.CharacterAdded:Wait()
    local humanoid = personaje:WaitForChild("Humanoid")
    local root = personaje:WaitForChild("HumanoidRootPart")

    while humanoid.Health > 0 do
        if (root.Position - destino).Magnitude <= DISTANCIA_LLEGADA then
            return true
        end

        local ruta = calcularRuta(root.Position, destino)

        if not ruta then
            task.wait(TIEMPO_REINTENTO)
            continue
        end

        local recalcular = false

        for indice, punto in ipairs(ruta:GetWaypoints()) do
            if indice > 1 then
                if punto.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                end

                humanoid:MoveTo(punto.Position)

                local llego = humanoid.MoveToFinished:Wait()

                if not llego then
                    recalcular = true
                    break
                end

                if (root.Position - destino).Magnitude <= DISTANCIA_LLEGADA then
                    return true
                end
            end
        end

        if not recalcular then
            task.wait(0.1)
        end
    end

    return false
end

-- Orientar el personaje hacia el objetivo
local function apuntarHacia(destino)
    local personaje = player.Character
    if not personaje then return end

    local root = personaje:FindFirstChild("HumanoidRootPart")
    local humanoid = personaje:FindFirstChildOfClass("Humanoid")

    if not root then return end

    local posicion = Vector3.new(
        destino.X,
        root.Position.Y,
        destino.Z
    )

    if humanoid then
        humanoid.AutoRotate = false
    end

    root.CFrame = CFrame.lookAt(root.Position, posicion)

    task.wait(0.2)

    if humanoid then
        humanoid.AutoRotate = true
    end
end

